  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8590",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments / YARD",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.keyword.yard",
        "comment.line.type.yard",
        "comment.line.parameter.yard"
      ],
      "settings": {
        "foreground": "#8fa3b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.special-method",
        "keyword.control.pseudo-method"
      ],
      "settings": {
        "foreground": "#ff8b39"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Word operators (new, typeof, instanceof, and/or/not)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ff8b39"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.separator.method",
        "punctuation.separator.namespace"
      ],
      "settings": {
        "foreground": "#9aa4ae"
      }
    },
    {
      "name": "Plain variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.block",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.block.parameters variable",
        "variable.other.block.ruby"
      ],
      "settings": {
        "foreground": "#d4d4d4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.unquoted.heredoc",
        "string.template"
      ],
      "settings": {
        "foreground": "#a5e075"
      }
    },
    {
      "name": "Escapes and interpolation markers",
      "scope": [
        "constant.character.escape",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "Interpolated code inside strings",
      "scope": [
        "meta.embedded.line",
        "meta.template.expression",
        "string.interpolated meta.embedded"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "punctuation.section.regexp",
        "punctuation.definition.group.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#00e5e5"
      }
    },
    {
      "name": "Regex slashes",
      "scope": [
        "string.regexp punctuation.definition.string",
        "string.regexp punctuation.definition.string.begin",
        "string.regexp punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#00e5e5"
      }
    },
    {
      "name": "Regex anchors and quantifiers",
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "name": "Language constants (true, false, nil, null, undefined)",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.nil",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "self / this / super",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this",
        "variable.language.super",
        "variable.language.ruby"
      ],
      "settings": {
        "foreground": "#ffb454",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "meta.function-call.ruby",
        "entity.name.function.ruby",
        "support.function.kernel.ruby"
      ],
      "settings": {
        "foreground": "#ffd75e"
      }
    },
    {
      "name": "Classes, modules and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.class.ruby",
        "entity.name.type.module.ruby",
        "support.class.ruby"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.name.variable.property"
      ],
      "settings": {
        "foreground": "#c58cff"
      }
    },
    {
      "name": "Decorators / annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffb454",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff4050",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff4050",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Ruby symbols and hash keys",
      "scope": [
        "constant.language.symbol.ruby",
        "constant.other.symbol.ruby",
        "constant.language.symbol.hashkey.ruby",
        "constant.other.symbol.hashkey.ruby",
        "constant.other.symbol.hashkey.parameter.function.ruby",
        "constant.language.symbol.interpolated.ruby",
        "punctuation.definition.constant.ruby",
        "punctuation.definition.constant.hashkey.ruby",
        "punctuation.definition.symbol.begin.ruby",
        "punctuation.definition.symbol.end.ruby"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Ruby instance, class and global variables",
      "scope": [
        "variable.other.readwrite.instance.ruby",
        "variable.other.readwrite.class.ruby",
        "variable.other.readwrite.global.ruby",
        "variable.other.readwrite.global.pre-defined.ruby",
        "punctuation.definition.variable.ruby"
      ],
      "settings": {
        "foreground": "#c58cff"
      }
    },
    {
      "name": "Ruby constants",
      "scope": [
        "variable.other.constant.ruby"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "name": "Ruby def / class / module / do / end",
      "scope": [
        "keyword.control.def.ruby",
        "keyword.control.class.ruby",
        "keyword.control.module.ruby",
        "keyword.control.start-block.ruby",
        "keyword.control.ruby"
      ],
      "settings": {
        "foreground": "#ff8b39"
      }
    },
    {
      "name": "Ruby block pipes |x|",
      "scope": [
        "punctuation.separator.variable.ruby"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Ruby require / include / attr_*",
      "scope": [
        "meta.require.ruby keyword.other.special-method.ruby",
        "keyword.other.special-method.ruby"
      ],
      "settings": {
        "foreground": "#ff8b39",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HAML tags (%div)",
      "scope": [
        "entity.name.tag.haml",
        "meta.tag.haml punctuation.definition.tag.haml"
      ],
      "settings": {
        "foreground": "#ff6b7f"
      }
    },
    {
      "name": "HAML .class",
      "scope": [
        "text.haml entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "name": "HAML #id",
      "scope": [
        "text.haml entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "HAML = / - / != Ruby markers",
      "scope": [
        "meta.line.ruby.haml",
        "meta.line.ruby.interpolated.haml",
        "keyword.control.ruby.start-block"
      ],
